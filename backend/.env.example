# ═══════════════════════════════════════
# AI Media Detector — Environment Variables
# Copy this to .env and fill in your values
# ═══════════════════════════════════════

# ── Server ──────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Firebase Admin SDK ──────────────────
# From Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── AI Detection APIs ────────────────────
# Get Sightengine API keys: https://sightengine.com (best for AI image detection)
SIGHTENGINE_API_USER=your_api_user
SIGHTENGINE_API_SECRET=your_api_secret

# Get Hive API key: https://thehive.ai
HIVE_API_KEY=your_hive_api_key

# Get OpenAI API key: https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-key

# ── Note ────────────────────────────────
# The app will use APIs in this priority order:
# 1. Sightengine (specialized AI detection)
# 2. Hive (moderation API)
# 3. OpenAI Vision (GPT-4o)
# 4. Heuristic analysis (fallback, no API needed)
