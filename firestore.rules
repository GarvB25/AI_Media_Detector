// ═══════════════════════════════════════
// Firestore Security Rules
// Paste these in Firebase Console > Firestore > Rules
// ═══════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Detections: users can only read/write their own records
    match /detections/{docId} {
      // Allow read only if the document belongs to the authenticated user
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Allow create only if userId matches the authenticated user
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'filename', 'verdict', 'confidence', 'createdAt']);

      // Allow update only for own records
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Block all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
